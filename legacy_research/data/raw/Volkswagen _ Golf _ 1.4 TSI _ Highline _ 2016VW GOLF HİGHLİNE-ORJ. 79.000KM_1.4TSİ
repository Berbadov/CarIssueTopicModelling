<script type="text/javascript">
var checkClassifiedPhotos = function () {
    var readCookie = function (name) {
            var nameEQ = name + '=',
                ca = document.cookie.split(';'),
                i = 0,
                c;
            for (; i < ca.length; i++) {
                c = ca[i];
                while (c.charAt(0) == ' ') {
                    c = c.substring(1, c.length);
                }
                if (c.indexOf(nameEQ) === 0) {
                    return c.substring(nameEQ.length, c.length);
                }
            }
            return null;
        },
        param = function (object) {
            var encodedString = '',
                prop;
            for (prop in object) {
                if (object.hasOwnProperty(prop)) {
                    if (encodedString.length > 0) {
                        encodedString += '&';
                    }
                    encodedString += encodeURI(prop + '=' + object[prop]);
                }
            }
            return encodedString;
        },
        post = function (requestUrl, data) {
            var xhr = new XMLHttpRequest();
            xhr.open('POST', requestUrl + '?' + param(data));
            xhr.setRequestHeader('Content-Type', 'application/x-www-form-urlencoded');
            xhr.send();
        },
        isImageLoaded = function (img) {
            return (img && !img.complete && !img.naturalWidth) ? false : true;
        },
        createAndSendPhotosReport = function () {
            var standartImage = document.getElementsByClassName('stdImg')[0],
                thumbnailImages = document.getElementsByClassName('thmbImg'),
                thumbnailImagesLength = thumbnailImages.length,
                data = {
                    id: standartImage ? (standartImage.src.split('_')[1] ? standartImage.src.split('_')[1].slice(0, -7) : 0) : 0,
                    x5Loaded: false,
                    thmbsLoaded: false,
                    thmbsTotal: thumbnailImagesLength,
                    thmbsLoadCount: 0,
                    timeout: timeout
                },
                i = 0,
                thumbnailPath;

            // For Standart Image
            if (isImageLoaded(standartImage)) {
                data.x5Loaded = true;
            } else {
                data.x5 = standartImage.src.slice(-7, -4);
            }

            // For Thumbnail Images
            for (i; i < thumbnailImagesLength; i++) {
                if (isImageLoaded(thumbnailImages[i])) {
                    data.thmbsLoadCount++;
                } else {
                    thumbnailPath = thumbnailImages[i].src;

                    if (data.thmbs) {
                        data.thmbs += ',' + thumbnailPath.slice(-7, -4);
                    } else {
                        data.thmbs = thumbnailPath.slice(-7, -4);
                    }
                }
            }

            // Is All Thumbnails Loaded
            if (thumbnailImagesLength == data.thmbsLoadCount) {
                data.thmbsLoaded = true;
            }

            // Send Report
            post('/ajax/classifiedPhotosReport', data);

            // Any Photos Are Not Loaded
            if (timeout < 32000) { // Max Time: 32s - Max Request: 6
                if (!data.x5Loaded || !data.thmbsLoaded) {
                    previousTimeout = timeout;
                    timeout *= 2;

                    setTimeout(createAndSendPhotosReport, timeout - previousTimeout);
                }
            }
        },
        timeout = 1000,
        previousTimeout;

    // Open For 10%
    if (readCookie('vid') < 100) {
        setTimeout(createAndSendPhotosReport, timeout);
    }
};

// For the Encapsulation
checkClassifiedPhotos();
</script>
